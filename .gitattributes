# ==============================================================================
# Git Attributes configuration for Unity project with Git LFS
# ==============================================================================

# Auto-detect text files and normalize line endings to LF on commit
* text=auto

# Unity Text Files (force LF and text handling)
*.cs text diff=csharp
*.cginc text
*.shader text
*.shadergraph text
*.hlsl text
*.unity text
*.prefab text
*.mat text
*.asset text
*.meta text
*.txt text
*.json text
*.xml text
*.md text

# ==============================================================================
# Git LFS (Large File Storage) tracking
# ==============================================================================

## 3D Models and Meshes
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
